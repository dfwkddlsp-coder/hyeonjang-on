{
  "name": "hyeonjang-on",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "db:local": "wrangler d1 execute hyeonjang-on-db --local --file schema.sql",
    "db:remote": "wrangler d1 execute hyeonjang-on-db --remote --file schema.sql",
    "deploy": "wrangler deploy",
    "test": "node tests/api.test.mjs",
    "check": "node tests/check.mjs",
    "test:push": "node tests/push-check.mjs",
    "test:sched": "node --test tests/schedule-parse.test.mjs tests/schedule-excel.test.mjs tests/schedule-ics.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
